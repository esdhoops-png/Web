# Contact form endpoint (Formspree-compatible: accepts a JSON POST and returns 2xx).
# Example: https://formspree.io/f/xxxxxxx — leave empty until a real service is configured.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Public URL of the deployed site (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=

# Set to "true" to allow search engines to index the proposal (default: noindex).
NEXT_PUBLIC_ALLOW_INDEXING=false
